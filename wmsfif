          <div class="query-item" style="align-self:center;">
            <button class="wms-btn wms-btn-primary" onclick="doQuery()">查询</button>
            <button class="wms-btn wms-btn-default" style="margin-left:6px;" onclick="resetQuery()">重置</button>
          </div>
        </div>

