  </header>

  <!-- Toast -->
  <div class="toast" id="toast"></div>

  <!-- Log Modal -->
  <div class="modal-overlay" id="logModal">
    <div class="modal" style="max-width:600px;">
      <h3>操作日志</h3>
      <div style="max-height:360px;overflow-y:auto;">
        <table class="wms-table" style="font-size:13px;">
          <thead>
            <tr>
              <th style="width:60px;">序号</th>
              <th style="width:180px;">操作日期</th>
              <th>动作</th>
            </tr>
          </thead>
          <tbody id="logTableBody"></tbody>
        </table>
        <div id="logEmpty" style="text-align:center;padding:40px;color:var(--text-placeholder);display:none;">暂无操作日志</div>
      </div>
      <div class="btn-row" style="margin-top:16px;">
        <button class="wms-btn wms-btn-default" onclick="closeLogModal()">关闭</button>
      </div>
    </div>
  </div>

  <!-- Import Modal -->
  <div class="modal-overlay" id="importModal">
    <div class="modal" style="max-width:480px;">
      <h3>导入管控天数配置</h3>
      <p style="margin-bottom:8px;">请先下载导入模版，按模版格式填写数据后上传。</p>
      <div class="btn-row" style="margin-bottom:16px;">
        <button class="wms-btn wms-btn-primary" onclick="downloadTemplate()" style="height:36px;">📥 下载模版</button>
      </div>
      <div style="border:2px dashed var(--border);border-radius:8px;padding:24px;text-align:center;margin-bottom:16px;background:#FAFAFA;">
        <p style="color:var(--text-secondary);margin-bottom:12px;">选择文件上传（.xlsx / .csv）</p>
        <input type="file" id="importFileInput" accept=".xlsx,.csv" style="display:none;" onchange="handleFileSelect(event)">
        <button class="wms-btn wms-btn-primary wms-btn-sm" onclick="document.getElementById('importFileInput').click()">选择文件</button>
      </div>
      <div class="btn-row">
        <button class="wms-btn wms-btn-default" onclick="closeImportModal()">关闭</button>
        <button class="wms-btn wms-btn-primary" onclick="confirmImport()">确认导入</button>
      </div>
    </div>
  </div>

  <!-- Confirm Modal -->
  <div class="modal-overlay" id="deleteModal">
    <div class="modal">
      <h3>确认删除</h3>
      <p>确定要删除选中的配置记录吗？此操作不可撤销。</p>
      <div class="btn-row">
        <button class="wms-btn wms-btn-default" onclick="closeDeleteModal()">取消</button>
        <button class="wms-btn wms-btn-danger" onclick="confirmDelete()">确认删除</button>
      </div>
    </div>
  </div>

  <!-- Global dropdown (appended to body, positioned via JS) -->
  <div class="sel-dropdown" id="globalDropdown"></div>

  <!-- Layout -->
  <div class="wms-layout">
    <aside class="wms-sidebar">
      <div class="menu-group">▼ 基础设置</div>
      <div class="menu-item">物料资料</div>
      <div class="menu-item">品类管理</div>
      <div class="menu-item">仓库资料</div>
      <div class="menu-item active">派仓规则配置</div>
      <div class="menu-item">管控天数配置</div>
      <div class="menu-item">其他配置</div>
      <div class="menu-group">▼ 入库管理</div>
      <div class="menu-item">入库任务</div>
      <div class="menu-item">入库记录</div>
      <div class="menu-group">▼ 出库管理</div>
      <div class="menu-item">出库任务</div>
    </aside>

    <main class="wms-main">
      <div class="wms-breadcrumb">
        配置管理 <span class="sep">/</span> <span class="current">管控天数配置</span>
      </div>

      <div class="wms-tabs">
        <button class="wms-tab active">管控天数配置</button>
      </div>

      <div class="wms-card">
        <!-- 查询条件 -->
        <div class="query-bar">
          <div class="query-item">
            <span class="query-label">基地：</span>
            <div class="sel-trigger" id="q-trigger-base" onclick="openQueryDropdown('base',event)">
              <span class="placeholder">请选择基地（可多选）</span>
              <span class="arrow">▼</span>
            </div>
          </div>
          <div class="query-item">
            <span class="query-label">仓库：</span>
            <div class="sel-trigger" id="q-trigger-warehouse" onclick="openQueryDropdown('warehouse',event)">
              <span class="placeholder">请选择仓库（可多选）</span>
              <span class="arrow">▼</span>
            </div>
          </div>
          <div class="query-item">
            <span class="query-label">物料编码：</span>
