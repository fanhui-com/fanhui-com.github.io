<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>管控天数配置 - 格力WMS系统</title>
  <style>
    /* ===== WMS Design System ===== */
    :root {
      --primary: #3F99A3;
      --primary-light: #DBEEEC;
      --link: #409EFF;
      --header-bg: #3F99A3;
      --text-title: #333333;
      --text-body: #606266;
      --text-secondary: #909399;
      --text-placeholder: #C0C4CC;
      --bg-white: #FFFFFF;
      --bg-page: #F5F7FA;
      --bg-header: #FAFAFA;
      --border: #DCDFE6;
      --border-light: #EBEEF5;
      --success: #67C23A;
      --warning: #E6A23C;
      --danger: #F56C6C;
      --info: #909399;
      --font: -apple-system, "PingFang SC", "Microsoft Yahei", sans-serif;
      --radius: 4px;
      --radius-sm: 3px;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: var(--font);
      font-size: 14px;
      color: var(--text-body);
      background: var(--bg-page);
    }

    /* Header */
    .wms-header {
      height: 50px; background: var(--primary); color: #fff;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 24px; font-size: 18px; font-weight: 500;
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    }
    .header-left { display: flex; align-items: center; gap: 8px; }
    .header-right { display: flex; align-items: center; gap: 16px; font-size: 13px; font-weight: 400; }
    .header-right .user-info { color: rgba(255,255,255,0.9); }
    .header-right .sep { color: rgba(255,255,255,0.5); margin: 0 4px; }
    .header-right a { color: #fff; text-decoration: none; cursor: pointer; }
    .header-right a:hover { text-decoration: underline; }
    .header-btn { height: 28px; padding: 0 12px; font-size: 12px; background: rgba(255,255,255,0.2); color: #fff; border: 1px solid rgba(255,255,255,0.3); border-radius: var(--radius-sm); cursor: pointer; }
    .header-btn:hover { background: rgba(255,255,255,0.3); }

    /* Layout */
    .wms-layout { display: flex; padding-top: 50px; min-height: 100vh; }
    .wms-sidebar {
      width: 200px; background: var(--bg-white);
      border-right: 1px solid var(--border-light); flex-shrink: 0; padding: 0;
    }
    .menu-group {
      padding: 10px 16px 6px; font-size: 13px; color: var(--text-title); font-weight: 600;
      display: flex; align-items: center; gap: 4px; cursor: pointer;
    }
    .menu-group .arrow-icon { font-size: 10px; transition: transform 0.2s; }
    .menu-group.collapsed .arrow-icon { transform: rotate(-90deg); }
    .menu-item { height: 38px; line-height: 38px; padding: 0 20px 0 28px; font-size: 13px; color: rgba(0,0,0,0.65); cursor: pointer; }
    .menu-item:hover { background: var(--bg-page); }
    .menu-item.active { background: var(--primary-light); color: var(--primary); font-weight: 500; }

    /* Main */
    .wms-main { flex: 1; padding: 12px 20px 20px; overflow: auto; }
    .wms-breadcrumb { font-size: 14px; color: var(--text-body); margin-bottom: 12px; }
    .wms-breadcrumb .sep { margin: 0 6px; color: var(--text-placeholder); }
    .wms-breadcrumb .current { color: var(--text-title); font-weight: 500; }

    /* Tabs */
    .wms-tabs { display: flex; border-bottom: 2px solid var(--border-light); margin-bottom: 16px; }
    .wms-tab { height: 40px; line-height: 40px; padding: 0 20px; font-size: 14px; color: var(--text-body); cursor: pointer; position: relative; border: none; background: none; }
    .wms-tab.active { color: var(--primary); font-weight: 500; }
    .wms-tab.active::after { content: ''; position: absolute; bottom: -2px; left: 0; right: 0; height: 2px; background: var(--primary); }

    /* Content Card */
    .wms-card { background: var(--bg-white); border-radius: var(--radius); padding: 16px 20px; box-shadow: 0 1px 4px rgba(0,0,0,0.04); }

    /* Query Bar */
    .query-bar {
      display: flex; gap: 16px; align-items: flex-start; flex-wrap: wrap;
      margin-bottom: 12px; padding-bottom: 12px;
      border-bottom: 1px dashed var(--border-light);
    }
    .query-item { display: flex; align-items: center; gap: 6px; }
    .query-label { font-size: 14px; color: var(--text-title); white-space: nowrap; font-weight: 500; }
    .query-item .sel-trigger { width: 180px; min-height: 32px; }
    .query-input { height: 32px; padding: 0 10px; border: 1px solid var(--border); border-radius: var(--radius); font-size: 14px; color: var(--text-body); outline: none; width: 180px; box-sizing: border-box; }
    .query-input:focus { border-color: var(--link); }
    .query-input::placeholder { color: var(--text-placeholder); }

    /* Buttons */
    .action-bar { display: flex; gap: 8px; margin-bottom: 16px; align-items: center; }
    .wms-btn { height: 32px; padding: 0 16px; font-size: 14px; border-radius: var(--radius-sm); cursor: pointer; display: inline-flex; align-items: center; gap: 4px; transition: all 0.2s; }
    .wms-btn-primary { background: var(--primary); color: #fff; border: none; }
    .wms-btn-primary:hover { background: #358A94; }
    .wms-btn-default { background: #fff; color: var(--text-body); border: 1px solid var(--border); }
    .wms-btn-default:hover { color: var(--primary); border-color: var(--primary); }
    .wms-btn-danger { background: #fff; color: var(--danger); border: 1px solid var(--danger); }
    .wms-btn-danger:hover { background: var(--danger); color: #fff; }
    .wms-btn-text { background: none; border: none; color: var(--link); padding: 0 6px; height: 28px; cursor: pointer; font-size: 14px; }
    .wms-btn-text:hover { color: var(--primary); }
    .wms-btn-text.danger { color: var(--danger); }
    .wms-btn-text.danger:hover { color: #d9363e; }
    .wms-btn-sm { height: 28px; padding: 0 12px; font-size: 13px; }

    /* Row link */
    .row-link { color: var(--link); cursor: pointer; text-decoration: none; font-size: 14px; }
    .row-link:hover { color: var(--primary); text-decoration: underline; }

    /* Pagination */
    .wms-pagination { display: flex; align-items: center; justify-content: flex-end; gap: 8px; margin-top: 16px; }
    .wms-pagination .total { font-size: 13px; color: var(--text-secondary); }
    .wms-pagination button {
      height: 30px; min-width: 30px; padding: 0 8px; font-size: 13px;
      border: 1px solid var(--border); background: #fff; color: var(--text-body);
      border-radius: var(--radius-sm); cursor: pointer;
    }
    .wms-pagination button:hover { border-color: var(--primary); color: var(--primary); }
    .wms-pagination button:disabled { color: var(--text-placeholder); cursor: not-allowed; }
    .wms-pagination button.active { background: var(--primary); color: #fff; border-color: var(--primary); }
    .page-size-select {
      height: 30px; padding: 0 8px; font-size: 13px; border: 1px solid var(--border);
      border-radius: var(--radius-sm); color: var(--text-body); outline: none; cursor: pointer;
    }

    /* Toast */
    .toast { position: fixed; top: 70px; left: 50%; transform: translateX(-50%); padding: 10px 24px; border-radius: var(--radius); font-size: 14px; color: #fff; z-index: 9999; opacity: 0; transition: opacity 0.3s; pointer-events: none; }
    .toast.show { opacity: 1; }
    .toast.success { background: var(--success); }
    .toast.error { background: var(--danger); }

    /* Table */
    .wms-table { width: 100%; border-collapse: collapse; font-size: 14px; }
    .wms-table thead th { background: var(--bg-header); color: var(--text-title); font-weight: 500; font-size: 13px; height: 40px; padding: 0 12px; text-align: left; border-bottom: 1px solid var(--border-light); }
    .wms-table tbody td { padding: 0 12px; color: var(--text-body); border-bottom: 1px solid var(--border-light); vertical-align: middle; }
    .wms-table tbody td { height: 48px; }
    .wms-table tbody tr:nth-child(even) { background: #FAFAFA; }
    .wms-table tbody tr:hover { background: #F5F7FA; }
    .wms-table tbody tr.editing { background: #FFF8E6; }
    .wms-table tbody tr.editing:hover { background: #FFF0C2; }
    .wms-table tbody tr.editing td { height: auto; vertical-align: top; padding-top: 8px; padding-bottom: 8px; }
    .wms-table .checkbox { width: 16px; height: 16px; cursor: pointer; }

    /* Inline Input */
    .wms-input-inline { height: 32px; padding: 0 10px; border: 1px solid var(--border); border-radius: var(--radius); font-size: 14px; color: var(--text-body); outline: none; width: 100%; box-sizing: border-box; }
    .wms-input-inline:focus { border-color: var(--link); }
    .wms-input-inline::placeholder { color: var(--text-placeholder); }
    .wms-input-inline.is-error { border-color: var(--danger) !important; background: #FFF5F5; }

    /* ========== SELECT TRIGGER (shared) ========== */
    .sel-trigger {
      min-height: 32px; padding: 3px 28px 3px 8px;
      border: 1px solid var(--border); border-radius: var(--radius);
      background: #fff; cursor: pointer; position: relative;
      font-size: 14px; width: 100%; box-sizing: border-box;
      display: flex; align-items: center; gap: 4px; flex-wrap: wrap;
      user-select: none; transition: border-color 0.2s;
      line-height: 1.4;
    }
    .sel-trigger:hover { border-color: var(--link); }
    .sel-trigger.is-error { border-color: var(--danger) !important; background: #FFF5F5; }
    .sel-trigger .arrow {
      position: absolute; right: 8px; top: 50%; transform: translateY(-50%);
      font-size: 11px; color: var(--text-placeholder); transition: transform 0.2s;
    }
    .sel-trigger.open .arrow { transform: translateY(-50%) rotate(180deg); }
    .sel-trigger .placeholder { color: var(--text-placeholder); font-size: 14px; line-height: 26px; }

    /* Multi-select chip */
    .sel-chip {
      display: inline-flex; align-items: center;
      height: 24px; line-height: 22px;
      padding: 0 4px 0 8px;
      font-size: 12px; border-radius: 3px;
      background: rgba(63,153,163,0.1); color: var(--primary);
      border: 1px solid rgba(63,153,163,0.25);
      white-space: nowrap; gap: 2px;
    }
    .sel-chip .chip-close {
      display: inline-flex; align-items: center; justify-content: center;
      width: 16px; height: 16px; font-size: 11px; color: rgba(63,153,163,0.6);
      border-radius: 50%; cursor: pointer; transition: all 0.15s;
    }
    .sel-chip .chip-close:hover { color: #fff; background: var(--primary); }

    /* Single-select trigger */
    .sel-trigger-single .sel-value {
      color: var(--text-body); font-size: 14px; line-height: 26px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .single-clear {
      display: inline-flex; align-items: center; justify-content: center;
      width: 18px; height: 18px; font-size: 12px; color: var(--text-placeholder);
      border-radius: 50%; cursor: pointer; margin-left: 2px;
      flex-shrink: 0; line-height: 1;
    }
    .single-clear:hover { color: #fff; background: var(--danger); }

    /* ========== DROPDOWN PANEL ========== */
    .sel-dropdown {
      position: fixed; z-index: 2000;
      background: #fff; border: 1px solid var(--border);
      border-radius: var(--radius); box-shadow: 0 4px 16px rgba(0,0,0,0.12);
      min-width: 180px; max-height: 240px; overflow-y: auto;
      display: none; padding: 4px 0;
    }
    .sel-dropdown.show { display: block; }
    .sel-dropdown::-webkit-scrollbar { width: 6px; }
    .sel-dropdown::-webkit-scrollbar-thumb { background: var(--text-placeholder); border-radius: 3px; }

    .sel-dropdown .dd-search {
      margin: 4px 8px 6px; height: 30px; padding: 0 8px;
      border: 1px solid var(--border-light); border-radius: 3px;
      font-size: 13px; outline: none; width: calc(100% - 16px); box-sizing: border-box;
    }
    .sel-dropdown .dd-search:focus { border-color: var(--link); }
    .sel-dropdown .dd-search::placeholder { color: var(--text-placeholder); }

    .sel-dropdown .dd-item {
      display: flex; align-items: center; gap: 8px;
      height: 34px; padding: 0 12px; cursor: pointer;
      font-size: 13px; color: var(--text-body);
      transition: background 0.1s;
    }
    .sel-dropdown .dd-item:hover { background: #F5F7FA; }
    .sel-dropdown .dd-item.selected { color: var(--primary); font-weight: 500; background: var(--primary-light); }
    .sel-dropdown .dd-item.hidden { display: none; }
    .sel-dropdown .dd-empty { padding: 16px; text-align: center; color: var(--text-placeholder); font-size: 13px; }

    /* Checkbox inside dropdown item (multi-select) */
    .dd-checkbox {
      width: 14px; height: 14px; border: 2px solid var(--border);
      border-radius: 2px; flex-shrink: 0; position: relative;
      transition: all 0.15s;
    }
    .dd-item.selected .dd-checkbox { background: var(--primary); border-color: var(--primary); }
    .dd-item.selected .dd-checkbox::after {
      content: ''; position: absolute; left: 3px; top: 0px;
      width: 4px; height: 8px;
      border: solid #fff; border-width: 0 2px 2px 0;
      transform: rotate(45deg);
    }

    /* Radio dot inside dropdown item (single-select) */
    .dd-radio {
      width: 14px; height: 14px; border: 2px solid var(--border);
      border-radius: 50%; flex-shrink: 0; position: relative;
      transition: all 0.15s;
    }
    .dd-item.selected .dd-radio { border-color: var(--primary); }
    .dd-item.selected .dd-radio::after {
      content: ''; position: absolute; left: 3px; top: 3px;
      width: 6px; height: 6px; border-radius: 50%; background: var(--primary);
    }

    /* Validation tips */
    .val-tip { font-size: 12px; margin-top: 4px; line-height: 1.4; color: var(--text-placeholder); }
    .val-tip.error { color: var(--danger); }
    .val-tip.warning { color: var(--warning); }

    /* Cell helpers */
    .cell-actions { display: flex; gap: 8px; align-items: center; }
    .cell-wrap { display: flex; flex-direction: column; }
    .cell-muted { color: var(--text-secondary); }
    .cell-required::before { content: '*'; color: var(--danger); margin-right: 2px; }

    /* Table wrapper */
    .table-wrapper { overflow-x: auto; }
    .table-wrapper::-webkit-scrollbar { height: 8px; }
    .table-wrapper::-webkit-scrollbar-thumb { background: #c1c1c1; border-radius: 4px; }

    /* Confirm modal */
    .modal-overlay { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.4); z-index: 1000; justify-content: center; align-items: center; }
    .modal-overlay.show { display: flex; }
    .modal { background: #fff; border-radius: 8px; padding: 24px 28px; max-width: 400px; width: 90%; box-shadow: 0 4px 16px rgba(0,0,0,0.15); }
    .modal h3 { font-size: 16px; font-weight: 500; color: var(--text-title); margin-bottom: 12px; }
    .modal p { font-size: 14px; color: var(--text-body); margin-bottom: 20px; line-height: 1.8; }
    .modal .btn-row { display: flex; gap: 10px; justify-content: flex-end; }
  </style>
