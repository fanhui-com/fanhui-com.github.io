<body>

  <!-- Header -->
  <header class="wms-header">
    <div class="header-left">
      <span>格力WMS系统</span>
    </div>
    <div class="header-right">
      <span class="user-info">👤 admin 管理员</span>
      <span class="sep">|</span>
      <span class="user-info">当前操作C4成品仓</span>
      <span class="sep">|</span>
